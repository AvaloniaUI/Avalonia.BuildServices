<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Version>12.0.0</Version>
        <!-- MSBuild on .NET Framework keeps one copy of a task assembly per identity for the
             life of the process. Two builds of this package with the same assembly version
             would share whichever copy loaded first, and a parameter that only the other
             one's targets file passes would fail the customer's build (MSB4064). The fourth
             component gives every CI build its own identity; pass -p:TaskAssemblyRevision=N
             to do the same for a local build. Version must be major.minor.patch[-suffix]. -->
        <TaskAssemblyRevision Condition="'$(TaskAssemblyRevision)' == '' And '$(GITHUB_RUN_NUMBER)' != ''">$([MSBuild]::Modulo($(GITHUB_RUN_NUMBER), 65535))</TaskAssemblyRevision>
        <TaskAssemblyRevision Condition="'$(TaskAssemblyRevision)' == ''">0</TaskAssemblyRevision>
        <AssemblyVersion>$(Version.Split('-')[0].Split('+')[0]).$(TaskAssemblyRevision)</AssemblyVersion>
        <RootNamespace>Avalonia.Telemetry</RootNamespace>
        <BuildOutputTargetFolder>tools</BuildOutputTargetFolder>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <NoWarn>$(NoWarn);NU1605;NU5128</NoWarn>
        <!-- Off by default for netstandard2.0. On, because this assembly runs
             inside customers' builds. -->
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>

        <Authors>Avalonia Team</Authors>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <DevelopmentDependency>true</DevelopmentDependency>
        <Copyright>Copyright 2023-$([System.DateTime]::Now.ToString(`yyyy`)) &#169; The AvaloniaUI Project</Copyright>
        <PackageProjectUrl>https://avaloniaui.net</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/AvaloniaUI/Avalonia.BuildServices</RepositoryUrl>
        <PackageIcon>Icon.png</PackageIcon>
        <PackageDescription>Avalonia is a cross-platform UI framework for .NET providing a flexible styling system and supporting a wide range of Operating Systems such as Windows, Linux, macOS and with experimental support for Android, iOS and WebAssembly.</PackageDescription>
        <PackageTags>avalonia;avaloniaui;mvvm;msbuild;telemetry</PackageTags>

        <GenerateNuspecDependsOn>$(GenerateNuspecDependsOn);_AddCollectorContent</GenerateNuspecDependsOn>
    </PropertyGroup>

    <Import Project="../Avalonia.BuildServices.Shared/Avalonia.BuildServices.Shared.projitems" Label="Shared" />

    <ItemGroup>
        <PackageReference Include="AvaloniaUI.Licensing" Version="3.1.3" PrivateAssets="All" />
        <PackageReference Include="System.Memory" Version="4.5.4" PrivateAssets="All"/>
        <PackageReference Include="Microsoft.Build.Framework" Version="15.1.1012" PrivateAssets="All"/>
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.205" PrivateAssets="All"/>

        <None Include="$(MSBuildThisFileDirectory)..\..\build\Icon.png" Pack="true" Visible="false" PackagePath=""/>
        <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" Visible="false" PackagePath=""/>

        <ProjectReference Include="../Avalonia.BuildServices.Collector/Avalonia.BuildServices.Collector.csproj" ReferenceOutputAssembly="false" Private="false" SetTargetFramework="TargetFramework=net5.0" IncludeAssets="none" ExcludeAssets="all" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Avalonia.BuildServices.Tests" />
    </ItemGroup>

    <!-- CsWin32 only picks up NativeMethods.txt beside the project file. -->
    <ItemGroup>
        <None Remove="Platform/NativeMethods.txt" />
        <AdditionalFiles Include="Platform/NativeMethods.txt" />
    </ItemGroup>

    <Target Name="_AddCollectorContent" BeforeTargets="_GetPackageFiles">
        <ItemGroup>
            <Content Include="$(MSBuildThisFileDirectory)../Avalonia.BuildServices.Collector/bin/$(Configuration)/net5.0/*.dll" PackagePath="tools/$(TargetFramework)"/>
            <Content Include="runtimeconfig.json">
                <CopyToOutputDirectory>Always</CopyToOutputDirectory>
                <Pack>true</Pack>
                <PackagePath>tools\$(TargetFramework)\</PackagePath>
            </Content>
            <Content Include="build/*.props" PackagePath="build;buildTransitive"/>
            <Content Include="build/*.targets" PackagePath="build;buildTransitive"/>
        </ItemGroup>
    </Target>
</Project>
