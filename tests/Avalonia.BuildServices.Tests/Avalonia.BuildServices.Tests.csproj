<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <!-- Runs on whichever newer runtime the machine has. -->
        <RollForward>Major</RollForward>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>Avalonia.Telemetry.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="All" />
    </ItemGroup>

    <!-- The task keeps these to itself (they are merged into it when it is
         packed), so the tests bring their own copies for it to load. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Build.Framework" Version="17.11.4" />

        <!-- The same version as the task's, and the same file: the
             netstandard2.0 assembly is the one that is merged into the task.
             The package's net6.0 assembly, which NuGet would pick here, is
             versioned 1.0.0.0, and the task could not load it in place of the
             3.1.3.0 it was compiled against. Nothing else of the package is
             wanted: its build files would run the licence check on the tests. -->
        <PackageReference Include="AvaloniaUI.Licensing" Version="3.1.3" ExcludeAssets="all" GeneratePathProperty="true" />
        <Reference Include="AvaloniaUI.Licensing" HintPath="$(PkgAvaloniaUI_Licensing)/lib/netstandard2.0/AvaloniaUI.Licensing.dll" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Avalonia.BuildServices/Avalonia.BuildServices.csproj" />
        <!-- Under an alias: the collector compiles the same shared source as
             the task, so every shared type would otherwise be found twice. -->
        <ProjectReference Include="../../src/Avalonia.BuildServices.Collector/Avalonia.BuildServices.Collector.csproj" Aliases="collector" />
    </ItemGroup>

</Project>
